# Optional. The contact form sends the visitor's message to YOUR WhatsApp and YOUR email.
# The simplest way is to type them in src/constants/contact.js (OWNER_WHATSAPP and OWNER_EMAIL).
# Or set them here / in Vercel > Settings > Environment Variables and redeploy.

# WhatsApp number, country code first, digits only (India: 91 + your 10 digits).
VITE_CONTACT_WHATSAPP=91XXXXXXXXXX

# Your email address.
VITE_CONTACT_EMAIL=you@example.com
